<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Faehigkeiten "Sign in with Apple" (docs/AUFTRAG-APPSTORE-V1.md, Abschnitt 2a und 7) und iCloud/CloudKit fuer die
  Community (docs/LOESUNGEN-TEILEN.md, Abschnitt 7; Container iCloud.de.uniflow.ai, derselbe Name wie
  UF_CLOUDKIT_CONTAINER in Config/Team.xcconfig). Gibt es nur mit dem bezahlten Apple Developer Program. Bewusst NICHT
  in project.yml eingetragen: aktiv nur ueber CODE_SIGN_ENTITLEMENTS, wenn ein bezahltes Team gesetzt ist, damit
  Personal-Team- und Simulator-Builds ohne diese Berechtigungen weiter bauen.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.de.uniflow.ai</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
