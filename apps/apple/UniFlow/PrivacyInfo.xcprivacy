<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Datenschutz-Manifest der App (docs/AUFTRAG-APPSTORE-V1.md, Abschnitt 7; docs/RELEASE-VORBEREITUNG.md).
  V1 laeuft ohne eigenen Server: Anmeldung mit Apple (die Kennung bleibt auf dem Geraet), Kaeufe (StoreKit),
  Stud.IP-/Learnweb-Daten, Notizen und Lernplan bleiben auf dem Geraet; kein Tracking, keine Analyse, keine Diagnose.
  Was das Geraet verlaesst (Stand 04.11.2026, docs/release/APP-STORE.md Abschnitt App-Datenschutz):
  - Oeffentliche CloudKit-Datenbank des Inhabers (nur in einem Build mit iCloud-Container, docs/LOESUNGEN-TEILEN.md
    Abschnitt 7): veroeffentlichte Loesungen, Kommentare, Likes, Korrekturvorschlaege und Meldungen der Community,
    gemeinsame Wochentests (WeeklyTest) und der gemeinsame Dokument-Index (DocIndex). Inhalte verschluesselt, Kopfdaten
    pseudonym; jeder Datensatz traegt die CloudKit-Nutzerkennung des Containers (creatorUserRecordID,
    ownerRecordName) -> NSPrivacyCollectedDataTypeUserID und NSPrivacyCollectedDataTypeOtherUserContent, beide mit der
    Kennung verknuepft (Apple-Definition: nicht vor der Erfassung von Kennungen getrennt), kein Tracking.
  - KI ueber das eigene ChatGPT des Nutzers (nur nach Verbinden und Zustimmung, docs/KI-CHATGPT-PLAN.md): Seitentext
    bzw. Markierung, Frage, Kurs- und Dateiname gehen direkt an OpenAI -> ebenfalls OtherUserContent.
  Nie Apple-ID, Name, E-Mail, Matrikelnummer, Hochschul-Zugangsdaten oder Kurs-ID.
  Genutzte APIs mit Begruendungspflicht:
  - UserDefaults (CA92.1): Einstellungen nur dieser App (je Container eine eigene Suite)
  - Datei-Zeitstempel (C617.1): Alter der Antworten im Zwischenspeicher im App-Container (ResponseCache)
  - Freier Speicher (E174.1): vor dem Laden einer Aufzeichnung pruefen, ob sie Platz hat (RecordingLibrary), ebenso
    vor jeder Datei des Hochschul-Abgleichs (DeviceStorage)
  Abgleich im Hintergrund (S8, BGTaskScheduler, lokale Benachrichtigungen): keine weitere API mit Begruendungspflicht,
  keine neuen Daten; er laeuft wie der Abgleich beim Oeffnen nur zwischen dem Geraet und der Hochschule, die
  Mitteilungen entstehen auf dem Geraet (ohne Push, ohne Server, ohne Dateinamen).
  Aendert sich etwas daran (z. B. ab V2 Abgleich ueber einen Server), Manifest und Angaben in App Store Connect
  gemeinsam anpassen.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
