<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Datenschutz-Manifest der App (docs/AUFTRAG-APPSTORE-V1.md, Abschnitt 7; docs/RELEASE-VORBEREITUNG.md).
  V1 laeuft ohne eigenen Server: Anmeldung mit Apple, Kaeufe (StoreKit), Stud.IP-/Learnweb-Daten, Notizen und
  Lernplan bleiben auf dem Geraet; kein Tracking. Einzige Ausnahme ist die Community (Plus, nur in einem Build mit
  iCloud-Container, docs/LOESUNGEN-TEILEN.md Abschnitt 7): Wer eine Loesung veroeffentlicht, laedt freiwillig seine
  eigenen Notizen (verschluesselt), ein Pseudonym und Kopfdaten in die oeffentliche CloudKit-Datenbank des Inhabers
  (NSPrivacyCollectedDataTypeOtherUserContent, nicht mit der Identitaet verknuepft, kein Tracking). Nie Apple-ID,
  Name, E-Mail oder Kurs-ID.
  Genutzte APIs mit Begruendungspflicht:
  - UserDefaults (CA92.1): Einstellungen nur dieser App (je Container eine eigene Suite)
  - Datei-Zeitstempel (C617.1): Alter der Antworten im Zwischenspeicher im App-Container (ResponseCache)
  - Freier Speicher (E174.1): vor dem Laden einer Aufzeichnung pruefen, ob sie Platz hat (RecordingLibrary), ebenso
    vor jeder Datei des Hochschul-Abgleichs (DeviceStorage)
  Abgleich im Hintergrund (S8, BGTaskScheduler, lokale Benachrichtigungen): keine weitere API mit Begruendungspflicht,
  keine neuen Daten; er laeuft wie der Abgleich beim Oeffnen nur zwischen dem Geraet und der Hochschule, die
  Mitteilungen entstehen auf dem Geraet (ohne Push, ohne Server, ohne Dateinamen).
  Aendert sich etwas daran (z. B. ab V2 Abgleich ueber einen Server), Manifest und Angaben in App Store Connect
  gemeinsam anpassen.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
