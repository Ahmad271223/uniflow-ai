{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniFlow",
  "version": "0.2.0",
  "identifier": "de.uniflow.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "UniFlow", "width": 1360, "height": 900, "minWidth": 900, "minHeight": 600, "url": "index.html" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
