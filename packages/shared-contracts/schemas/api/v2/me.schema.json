{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniflow.local/contracts/api/v2/me.json",
  "title": "GET /api/entitlements – Abo-Stand eines Kontos (StudiNow-Tarife, app/billing.py). Enthaelt nie Hochschul-Zugangsdaten.",
  "type": "object",
  "required": ["plan", "plan_name", "entitlements", "quotas", "integrations", "mode"],
  "properties": {
    "plan": { "enum": ["free", "plus", "pro_connect", "pro_ai", "local"] },
    "plan_name": { "type": "string" },
    "source": { "enum": ["app_store", "manual", null] },
    "expires_at": { "type": ["string", "null"] },
    "will_renew": { "type": "boolean" },
    "pending_plan": { "enum": ["free", "plus", "pro_connect", "pro_ai", null] },
    "mode": { "enum": ["hosted", "local"] },
    "apple_account_token": { "type": "string" },
    "device": {
      "description": "Geraete-Regel (14.11.2026, app/device_limit.py). Nur fuer Apple-Apps, die X-StudiNow-Caps: device_limit schicken; aeltere Apps, Web und Windows bekommen das Feld nicht. blocked: Free auf einem zweiten Geraet (Hinweis-Bildschirm); hint_plus: Plus auf einem zweiten Geraet (einmaliger Hinweis, nie gesperrt).",
      "type": "object",
      "required": ["state", "is_primary", "upgrade_plan", "price_cents", "currency", "period"],
      "properties": {
        "state": { "enum": ["ok", "blocked", "hint_plus"] },
        "is_primary": { "type": "boolean" },
        "primary_name": { "type": ["string", "null"] },
        "primary_set_at": { "type": ["string", "null"] },
        "upgrade_plan": { "enum": ["pro_ai"] },
        "price_cents": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string" },
        "period": { "enum": ["year"] }
      }
    },
    "credits": {
      "description": "Credits der StudiNow-KI (app/credits.py); am eigenen PC null. allowance/used/reserved/remaining sind die Monats-Credits (unveraendert seit 04.11.2026). Seit 15.11.2026 zusaetzlich und freiwillig der gekaufte Topf: purchased (frei), purchased_usable (der Tarif hat die StudiNow-KI, sonst ruhen sie), available (Rest des Monats + nutzbare gekaufte), can_buy (plans.can_buy_credits). Aeltere Apps lesen die neuen Felder nicht.",
      "type": ["object", "null"],
      "required": ["period", "allowance", "used", "reserved", "remaining", "resets_at", "credit_eur"],
      "properties": {
        "period": { "type": "string" },
        "allowance": { "type": "integer", "minimum": 0 },
        "used": { "type": "integer", "minimum": 0 },
        "reserved": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 },
        "plan": { "type": ["string", "null"] },
        "resets_at": { "type": "string" },
        "credit_eur": { "type": "number", "minimum": 0 },
        "purchased": { "type": "integer", "minimum": 0 },
        "purchased_usable": { "type": "boolean" },
        "purchased_scope": { "description": "wofuer gekaufte Credits gelten: all (KI-Lernhilfe im Tarif: Pro AI, Probe), chat (Plus: nur der KI-Chat, Aufgabe tutor:ask), none (Free: sie ruhen)", "enum": ["all", "chat", "none"] },
        "available": { "type": "integer", "minimum": 0 },
        "can_buy": { "type": "boolean" }
      }
    },
    "credit_packs": {
      "description": "Credit-Pakete zum Nachkaufen (15.11.2026, plans.CREDIT_PACKS): Credits je Produkt-ID - die App zeigt diese Zahl und den Preis aus StoreKit - und wo man kaufen kann. Freiwilliges Feld.",
      "type": "object",
      "required": ["packs", "purchase"],
      "properties": {
        "packs": { "type": "array", "items": { "type": "object", "required": ["product_id", "credits"],
                   "properties": { "product_id": { "type": "string" }, "credits": { "type": "integer", "minimum": 1 } } } },
        "purchase": { "type": "object", "required": ["apple", "web"],
                      "properties": { "apple": { "type": "object", "required": ["available"], "properties": { "available": { "type": "boolean" }, "note": { "type": "string" } } },
                                      "web": { "type": "object", "required": ["available"], "properties": { "available": { "type": "boolean" }, "note": { "type": "string" } } } } }
      }
    },
    "entitlements": {
      "type": "object",
      "required": ["can_view_pdf", "can_annotate_pdf", "can_use_pencilkit", "can_sync_annotations", "can_write_community_comments", "can_use_ai_chat",
                   "can_share_solutions", "can_use_advanced_planner", "can_use_advanced_analytics", "can_access_shared_tests",
                   "can_generate_studora_ai_tests", "chatgpt_connection_premium"],
      "additionalProperties": { "type": "boolean" }
    },
    "quotas": {
      "type": "object",
      "required": ["ai_tests_new", "library_tests", "ai_assist", "card_stacks_adopted", "ai_mail"],
      "additionalProperties": {
        "type": "object", "required": ["used", "limit", "period"],
        "properties": { "used": { "type": "integer", "minimum": 0 }, "limit": { "type": ["integer", "null"], "minimum": 0 },
                        "unlimited": { "type": "boolean" }, "period": { "type": "string" } }
      }
    },
    "integrations": {
      "type": "object", "required": ["chatgpt"],
      "properties": { "chatgpt": { "type": "object", "required": ["status", "plan_gating_allowed"],
                                   "properties": { "status": { "enum": ["disabled", "enabled"] }, "plan_gating_allowed": { "type": "boolean" } } } }
    }
  }
}
