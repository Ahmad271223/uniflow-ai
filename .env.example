# Kopiere diese Datei nach .env und trage deine Daten ein.
# Die .env bleibt nur auf deinem PC (steht in .gitignore).

STUDIP_BASE=https://studip.uni-hannover.de
STUDIP_USER=DEINE-LUH-ID
STUDIP_PASSWORD=DEIN-WEBSSO-PASSWORT

# Welcher Claude-Modell-Alias fuer die KI-Schritte genutzt wird (sonnet, opus, haiku)
CLAUDE_MODEL=sonnet

# Nur Kurse ab diesem Semester synchronisieren (Teilstring des Semestertitels)
SEMESTER_FILTER=WiSe 2026/27

# Port der Web-Oberflaeche
PORT=8765

# --- Uni Hildesheim (Einstellungen > Zugang & Darstellung > Hochschule) ---
# UNI-Account fuer das CAS-Login von Learnweb und LSF
HILDESHEIM_USER=
HILDESHEIM_PASSWORD=
# Optional: Learnweb-Sicherheitsschluessel ("Moodle mobile web service", im Learnweb-Profil selbst erzeugt)
LEARNWEB_TOKEN=
# Optional: nur Learnweb-Kurse dieses Semesters (z. B. WiSe 2026/27); SEMESTER_FILTER gilt nur fuer die LUH
HILDESHEIM_SEMESTER_FILTER=
