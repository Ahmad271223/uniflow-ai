# StudiNow/UniFlow – gehosteter Dienst: Vorlage fuer deploy/.env
#
#   cp .env.example .env && chmod 600 .env        (NIE einchecken: .gitignore deckt .env ab)
#
# docker compose liest diese Datei: die UNIFLOW_*-Werte fuer docker-compose.yml und Caddy, alle LERNAPP_*-Werte gehen
# an den App-Container. Keine Anfuehrungszeichen um Werte noetig; Zeilen mit # sind Kommentare. Leer lassen = Standard.
# Reihenfolge = Reihenfolge beim Einrichten. Jede Zeile sagt, ob der Wert PFLICHT oder optional ist.
# Schritt-fuer-Schritt: docs/START-DIENST-CHECKLISTE.md; Betrieb im Detail: docs/release/BETRIEB.md

# ================================================================ 1. Domain und TLS (Caddy, deploy/Caddyfile)
# PFLICHT. Oeffentlicher Hostname des Dienstes; DNS A/AAAA zeigt auf den Server. Caddy holt dafuer das Zertifikat.
# docker-compose.yml setzt daraus auch LERNAPP_ALLOWED_HOSTS (siehe unten).
UNIFLOW_DOMAIN=app.example.de
# PFLICHT. Kontaktadresse fuer Let's Encrypt (Warnung, falls ein Zertifikat nicht erneuert werden kann). Ohne Wert startet
# Caddy nicht. Kein Mailversand der App.
UNIFLOW_ACME_EMAIL=hosting@example.de
# PFLICHT. Oeffentliche Adresse des Dienstes ohne Schraegstrich am Ende: Basis fuer Links in Mails
# (Bestaetigung, Passwort zuruecksetzen; app/mail.py) und Rueckkehr-Adressen nach dem Stripe-Checkout (app/stripe_billing.py).
LERNAPP_PUBLIC_URL=https://app.example.de
# Optional. Erlaubte Host-Kopfzeilen (Schutz gegen DNS-Rebinding, app/server.py). docker-compose.yml setzt den Wert fest
# auf UNIFLOW_DOMAIN; nur fuer den Start ohne Compose hier eintragen (mehrere Namen mit Komma).
LERNAPP_ALLOWED_HOSTS=app.example.de

# ================================================================ 2. Dienst-Geheimnis (app/vault.py) – NIE VERLIEREN
# PFLICHT. 32 Byte als base64 oder hex. Verschluesselt die Hochschul-Zugangsdaten aller Konten (Tresor in accounts.db).
# Erzeugen:  openssl rand -base64 32      oder      python3 -c "import secrets; print(secrets.token_hex(32))"
# Sofort in den Passwort-Manager, getrennt von den Backups (das Backup-Archiv enthaelt den Schluessel absichtlich nicht).
# Geht er verloren, sind alle Tresor-Werte unlesbar: Konten und Notizen bleiben, jeder Nutzer muss seine
# Hochschul-Zugangsdaten neu eingeben. Ohne Angabe erzeugt der Dienst /data/secret.key neben den Daten – fuer den
# Betrieb NICHT vorgesehen.
LERNAPP_SECRET_KEY=

# ================================================================ 3. Betriebsart (app/config.py) – im Image vorbelegt
# PFLICHT (steht schon im Image und in docker-compose.yml). hosted = Dienst mit Konten, jedes Konto mit eigenem Datenordner.
LERNAPP_MODE=hosted
# Fest: Daten- und Protokollordner im Container (Volumes uniflow-data, uniflow-logs). Nicht aendern.
LERNAPP_DATA_DIR=/data
LERNAPP_LOG_DIR=/logs
# PFLICHT im Dienst: stream = Hochschuldateien nie auf dem Server speichern, beim Oeffnen mit der Hochschulsitzung des
# Kontos durchreichen (app/filestream.py, hoechstens 300 MB je Datei). store = wie am PC, nur fuer Tests.
LERNAPP_FILES=stream
# PFLICHT hinter Caddy: 1 = Sitzungs-Cookie nur ueber https (Secure-Flag, app/account_api.py). docker-compose.yml setzt 1.
LERNAPP_HTTPS=1
# Optional. Ordner mit den Rechtstexten als Markdown (/datenschutz, /impressum, /nutzungsbedingungen, /konto-loeschen;
# app/legal.py). Im Image: die Dateien aus docs/release. Eigenen Ordner (ausgefuellte Platzhalter) als Volume einhaengen
# und hier den Pfad eintragen, oder im Repository ersetzen und neu bauen.
LERNAPP_LEGAL_DIR=/srv/uniflow/docs/release
# Nur Windows-App: eigener Ort der .env. Im Container leer lassen (die Werte kommen aus dieser Datei).
LERNAPP_ENV_FILE=
# Optional. Texterkennung fuer PDF-Seiten ohne Textebene (app/pageocr.py, docs/OCR-WINDOWS.md). Leer = im Dienst AUS (Serverlast),
# am PC an, wenn ein Motor gefunden wird. on = an (braucht `tesseract` im Image; Hochschuldateien liegen im Dienst nie auf der
# Platte, daher heute ohne Wirkung) | off = aus.
LERNAPP_OCR=
# Optional. Motor: tesseract (Standard) | windows (nur Windows-App, ungeprueft).
LERNAPP_OCR_ENGINE=
# Optional. Pfad zu tesseract(.exe), wenn es nicht im PATH oder im Ordner `tesseract` neben der exe liegt.
LERNAPP_TESSERACT=
# Optional. So viele Seiten werden gleichzeitig erkannt (Standard 2).
LERNAPP_OCR_JOBS=

# ================================================================ 4. Mailversand (app/mail.py)
# Bestaetigungslink nach der Registrierung, Passwort-zuruecksetzen-Link, Willkommensmail. Ohne Mail koennen sich Nutzer
# registrieren, aber ihre Adresse nicht bestaetigen und kein Passwort zuruecksetzen (Notbehelf: `docker compose exec app
# python -m app.accounts reset-token <email>`). Fuer den Start also PFLICHT: ein Anbieter mit SMTP (Resend, Brevo,
# Postmark, Mailgun ...), Domain dort verifizieren (SPF/DKIM im DNS), Anbieter in die Datenschutzerklaerung (Abschnitt 11),
# Auftragsverarbeitung abschliessen.
# Optional. off = kein Versand | log = Mail nur in /logs/mail.log (ein zentrales Protokoll fuer alle Konten; Link von dort
# holen) | smtp = Versand.
# Leer = automatisch: smtp, sobald LERNAPP_SMTP_HOST gesetzt ist, sonst log.
LERNAPP_MAIL=
# PFLICHT fuer den Versand. SMTP-Server des Anbieters (z. B. smtp.resend.com, smtp-relay.brevo.com).
LERNAPP_SMTP_HOST=
# Optional. 587 = STARTTLS (Standard), 465 = TLS von Anfang an.
LERNAPP_SMTP_PORT=587
# PFLICHT fuer den Versand (vom Anbieter; bei Resend ist der Nutzer `resend` und das Passwort der API-Schluessel).
LERNAPP_SMTP_USER=
LERNAPP_SMTP_PASSWORD=
# Optional. Absender; die Domain muss beim Anbieter verifiziert sein. Leer = SMTP-Nutzer bzw. no-reply@<Host von LERNAPP_PUBLIC_URL>.
LERNAPP_MAIL_FROM=StudiNow <no-reply@example.de>

# ================================================================ 5. Abos im Web ueber Stripe (app/stripe_billing.py)
# Optional zum Start (Entscheidung 30.10.: erst Free, jedes neue Konto 7 Tage Probe). Leer = kein Abschluss im Web
# (purchase.web.available = false, 503 stripe_not_configured); Konten, Probe und Free laufen trotzdem.
# Zum Einschalten im Stripe-Dashboard: (1) zwei monatliche Preise anlegen (Plus 1,99 EUR, Pro AI 3,99 EUR;
# app/plans.py, docs/PREISLISTE.md; Pro Connect gibt es seit 04.11.2026 nicht mehr), (2) Entwickler -> API-Schluessel: geheimer Schluessel, (3) Entwickler -> Webhooks:
# Endpunkt https://<UNIFLOW_DOMAIN>/api/billing/stripe/webhook mit den Ereignissen checkout.session.completed,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted -> Signaturgeheimnis,
# (4) Einstellungen -> Kundenportal einschalten. Erst mit sk_test_/Test-Preisen pruefen, dann auf live wechseln.
# Geheimer Schluessel: sk_live_... (oder sk_test_... zum Testen).
LERNAPP_STRIPE_SECRET_KEY=
# Signaturgeheimnis des Webhook-Endpunkts: whsec_...
LERNAPP_STRIPE_WEBHOOK_SECRET=
# Preis-IDs je Tarif, kommagetrennt:  plus=price_...,pro_ai=price_...
LERNAPP_STRIPE_PRICES=

# ================================================================ 6. StudiNow-KI ueber den Dienst (app/ai_backend.py)
# Optional zum Start. Pro AI und neue KI-Wochentests (ab Plus) laufen nur ueber den Dienst mit DEINEM OpenAI-Schluessel
# (platform.openai.com -> API keys); der Schluessel liegt nur hier, nie in einer App. Ohne Schluessel und Modell antworten
# diese Funktionen ehrlich 503 ai_not_configured, alles andere laeuft. Kosten traegt der Inhaber: Budgets unten setzen.
# Optional. openai | none. Leer = openai, sobald ein Schluessel gesetzt ist.
LERNAPP_AI_PROVIDER=
# PFLICHT fuer die KI. Schluessel sk-... des StudiNow-Kontos bei OpenAI (Responses API).
LERNAPP_OPENAI_API_KEY=
# PFLICHT fuer die KI. Modellname fuer alle Anfragen, z. B. gpt-6-luna (guenstig, Empfehlung in app/ai_prices.py) oder gpt-5-mini.
LERNAPP_AI_MODEL=
# Optional. Weitere Modelle (Komma-Liste), die ein Client ausdruecklich waehlen darf; jedes braucht einen Preis (sonst 400 model_not_allowed).
LERNAPP_AI_MODELS=
# Preise: der Dienst rechnet mit der Tabelle in app/ai_prices.py (USD je 1 Mio. Tokens, Stand dort in CHECKED – vor dem Start
# mit der OpenAI-Preisliste vergleichen). Fehlt der Preis des Modells, sperrt der Dienst alle KI-Aufrufe (503 ai_not_configured_prices).
# Optional. JSON, ueberschreibt/ergaenzt die Tabelle je Modell, z. B. {"gpt-6-luna": {"input": 0.1, "cached_input": 0.01, "output": 0.5}}
LERNAPP_AI_PRICES=
# Optional. Umrechnung USD -> EUR (Standard 1.0 = ein Dollar zaehlt als ein Euro, absichtlich vorsichtig).
LERNAPP_AI_USD_EUR=
# Optional, aeltere Angabe: EUR je 1 Mio. Tokens fuer ALLE Modelle (Eingabe/Ausgabe). Nur wenn beide > 0 sind, gelten sie statt
# der Tabelle. Leer oder 0 = Tabelle.
LERNAPP_AI_PRICE_IN_EUR=
LERNAPP_AI_PRICE_OUT_EUR=
# Optional. Obergrenze der Ausgabe-Tokens je Zweck (Denk-Tokens zaehlen mit), z. B. tutor=2000,flashcards=3000 (Standard in app/ai_backend.py MAX_OUTPUT).
LERNAPP_AI_MAX_OUTPUT=
# Optional. Denkaufwand fuer Denkmodelle (reasoning.effort): low (Standard) | medium | high | none = nicht senden.
LERNAPP_AI_REASONING_EFFORT=
# Optional. Monatsbudget gesamt (alle Konten) und je Konto in EUR; erreicht -> Sperre bis zum naechsten Monat.
LERNAPP_AI_BUDGET_EUR=50
LERNAPP_AI_USER_BUDGET_EUR=2
# Optional. Eigenes Monatsbudget in EUR fuer alle Probekonten (nur die 7-Tage-Probe aktiv) zusammen; es kommt zum Gesamtbudget
# dazu, die Probe verbraucht also nie das Budget zahlender Konten. Erreicht -> 429 ai_trial_budget_exhausted. StudiNow-KI gibt es
# ausserdem nur mit bestaetigter E-Mail-Adresse (403 email_unverified).
LERNAPP_AI_TRIAL_BUDGET_EUR=5
# Optional. Anfragen je Konto und Minute bzw. Stunde (429 ai_rate_limited).
LERNAPP_AI_RATE_PER_MINUTE=6
LERNAPP_AI_RATE_PER_HOUR=60
# Credits je Konto und Kalendermonat (Europe/Berlin; app/credits.py, Entscheidung 04.11.2026): 1 Credit = 1 Cent echter
# OpenAI-Kosten, nicht Verbrauchtes verfaellt am Monatsende, 429 credits_exhausted, wenn der Rest nicht reicht.
# Optional. Credits je Monat fuer Pro AI (Standard 100 = hoechstens 1 EUR KI-Kosten je Konto).
LERNAPP_CREDITS_PRO_AI=
# Optional. Credits je Monat fuer Plus und Free (Standard 0: KI nur ueber das eigene ChatGPT des Nutzers).
LERNAPP_CREDITS_PLUS=
LERNAPP_CREDITS_FREE=
# Optional. Credits je Monat waehrend der 7-Tage-Probe (Standard 25; das Probe-Becken LERNAPP_AI_TRIAL_BUDGET_EUR deckelt zusaetzlich).
LERNAPP_CREDITS_TRIAL=

# ================================================================ 7. Anmeldung mit Google/Apple (app/social_login.py)
# Optional. Erlaubte Client-IDs (Audience der ID-Tokens), kommagetrennt: Android-/iOS-Client-IDs bzw. Bundle-ID und
# Services-ID. Leer = Anbieter nicht eingerichtet (501 provider_not_configured), E-Mail und Passwort gehen immer.
# Die Web-Anmeldeseite braucht zusaetzlich die Web-Client-ID (wird automatisch mit erlaubt). Google: console.cloud.google.com
# -> OAuth-Client "Webanwendung" mit Herkunft https://<UNIFLOW_DOMAIN>. Apple braucht das Developer Program.
LERNAPP_GOOGLE_CLIENT_IDS=
LERNAPP_GOOGLE_WEB_CLIENT_ID=
LERNAPP_APPLE_CLIENT_IDS=
LERNAPP_APPLE_WEB_CLIENT_ID=

# ================================================================ 8. App-Store-Kaeufe (app/apple_store.py)
# Optional, erst mit der iPad-App. Pfade zu Apples Wurzelzertifikat(en) (PEM oder DER, z. B. "Apple Root CA - G3" von
# apple.com/certificateauthority), kommagetrennt, als Volume eingehaengt. Leer = Kaufpruefung aus (503 apple_not_configured).
LERNAPP_APPLE_ROOT_CERTS=
# Optional. Bundle-ID der iPad-App (Standard de.uniflow.ai).
LERNAPP_APPLE_BUNDLE_ID=de.uniflow.ai
# Optional. Apple-ID der App (Zahl aus App Store Connect -> App-Informationen -> Apple-ID). Fuer Einladungen (app/invites.py,
# docs/EINLADUNGEN.md): Belohnungen sind Angebotscodes, die Apples Dialog https://apps.apple.com/redeem?ctx=offercodes&id=<APP_ID>&code=…
# einloest. Leer = die App zeigt nur den Code ohne Link zu Apple.
LERNAPP_APPLE_APP_ID=

# ================================================================ 8b. Groesse des Rechners (Zahl der API-Prozesse)
# Optional. Ein API-Prozess traegt etwa 95 Anfragen je Sekunde und belegt 150-300 MB (docs/SKALIERUNG-GROSS.md). Faustregel:
# UVICORN_WORKERS = Zahl der Rechenkerne abzueglich 2 fuer Caddy und die Jobs; API_MEMORY = Prozesse x 300 MB.
# Beispiele: 2 vCPU/4 GB = 2 und 768M (Standard); 8 vCPU/16 GB = 6 und 2G; 48 Kerne/128 GB = 40 und 12G.
# Mehr Prozesse brauchen ein hoeheres LERNAPP_LIMIT_API_PER_MIN nicht (die Grenze zaehlt je Prozess), aber LERNAPP_LIMIT_REGISTER_IP.
UVICORN_WORKERS=2
API_MEMORY=768M

# ================================================================ 9. Hochschul-Abgleich und Grenzen (app/jobs.py)
# Der Dienst meldet sich fuer Konten mit Zugangsdaten (nur mit Zustimmung je Nutzer) per Chromium bei Stud.IP/Learnweb an.
# Mit docker-compose.yml OHNE WIRKUNG: dort bekommt der API-Container fest LERNAPP_JOBS=off, und der Container `jobs`
# (`python -m app.jobs`, gleiche Daten) uebernimmt Arbeiter, Zeitplan und Loeschfristen – noetig, weil die API mit zwei
# uvicorn-Prozessen laeuft (Lasttest 30.10.2026) und `inproc` den Runner in jedem Prozess starten wuerde.
# Nur fuer den Start ohne Compose: inproc = Arbeiter und Zeitplan im App-Prozess (dann uvicorn mit EINEM Prozess);
# off = keine Jobs in diesem Prozess (nur, wenn `python -m app.jobs` getrennt laeuft – sonst laufen auch die Loeschfristen nicht).
LERNAPP_JOBS=inproc
# Optional. Gleichzeitige Abgleiche = gleichzeitige Chromium-Browser, je 300–500 MB RAM. 2 passt zu 4 GB; bei 8 GB 4
# (dann in docker-compose.yml die Speichergrenze des Dienstes `jobs` erhoehen).
LERNAPP_JOB_WORKERS=2
# Optional. Uhrzeiten (Ortszeit, TZ=Europe/Berlin im Image), zu denen jedes Konto mit Zugangsdaten abgeglichen wird und
# die Wochentests laufen. Kommagetrennt, HH:MM.
LERNAPP_SYNC_TIMES=08:00,15:00
# Optional. Schont die Hochschulen: gleichzeitige Abgleiche je Hochschule und Sekunden zwischen zwei Starts je Hochschule.
LERNAPP_UNI_PARALLEL=2
LERNAPP_UNI_GAP_S=15
# Optional. Anfragen je Konto und Minute an /api (Schutz vor Skripten und Fehlern in einem Client).
LERNAPP_LIMIT_API_PER_MIN=600
# Registrierungen je Client-IP und Stunde (app/accounts.py, Grenze `register_ip`, Standard im Code 30/60). Im Hochschulnetz
# (eduroam, Hoersaal, Bibliothek) teilen sich hunderte Geraete wenige Adressen (NAT) – mit 30/h waere nach dem ersten
# Hoersaal Schluss (429 "Zu viele Versuche"). Startwert 300 je Stunde (Lasttest 30.10.2026, Empfehlung 3); beobachten:
# haeufen sich 429 bei der Registrierung, erhoehen; die Grenze je E-Mail-Adresse und das Passwort-Hashing bremsen Missbrauch
# weiter. Gilt nach `docker compose up -d` (ohne --build).
LERNAPP_LIMIT_REGISTER_IP=300/60
# Optional. Weitere Konto-Grenzen (app/accounts.py LIMITS) ueberschreiben: LERNAPP_LIMIT_<NAME>=Anzahl/Minuten,
# z. B. LERNAPP_LIMIT_RESET_IP=60/60. Normalerweise nicht noetig. Neue Kurs-/Modulschluessel je Konto und Tag in der
# Community: LERNAPP_LIMIT_COURSE_KEYS_USER (Standard 30/1440).
# Optional. Speicherplatz je Konto fuer eigene Uploads (Eigene Dokumente, Bilder im Editor, Aufnahmen) in MB.
LERNAPP_UPLOAD_QUOTA_MB=2048
# Optional. Sekunden, bis sich das Anmeldefenster der Hochschul-Anmeldung (app/unilogin.py) schliesst.
LERNAPP_UNILOGIN_TIMEOUT=300

# ================================================================ 10. Loeschfristen (app/retention.py)
# Taeglich ab dieser Uhrzeit (Ortszeit); der Backup-Timer laeuft davor (03:30). Die Zahlen muessen zur
# Datenschutzerklaerung passen (docs/release/DATENSCHUTZ.md: 14 Tage Zugriffsprotokoll, 90 Tage Abgleich-Protokolle).
LERNAPP_RETENTION_TIME=04:00
LERNAPP_RETENTION_ACCESS_DAYS=14
LERNAPP_RETENTION_SYNC_DAYS=90

# ================================================================ 11. Nur Einzelplatz/Windows-App – im Dienst leer lassen
# 1 = kein Takt der Wochentests im Einzelplatz-Prozess (Tests). Im Dienst laufen Wochentests ueber app/jobs.py.
LERNAPP_NO_SCHEDULER=
# Einzelplatz im WLAN: Zugriff ohne PIN von fremden Rechnern erlauben / LAN-Anzeige. Im Dienst ohne Wirkung.
LERNAPP_ALLOW_PUBLIC_CLIENTS=
LERNAPP_LAN=
# Setzt die Windows-App selbst (app/desktop.py, app/service_link.py): Fenster-Agent, Adresse des StudiNow-Dienstes,
# Geheimnis fuer /api/desktop/*.
LERNAPP_DESKTOP=
LERNAPP_SERVICE_URL=
LERNAPP_AGENT_TOKEN=

# ================================================================ 12. Erklaerungsspeicher (app/page_explain.py, 04.11.2026)
# Optional. Speichern und Loeschen geteilter Erklaerungen (/api/explain) je Konto und Tag: Anzahl/Minuten, Standard 120/1440.
# Nur Form und Groesse werden geprueft (Chiffrat hoechstens 256 KiB); der Dienst kann die Antworten nicht lesen.
LERNAPP_LIMIT_EXPLAIN_USER=

# ================================================================ 13. Einladungen (app/invites.py, 04.11.2026)
# Optional. Grenzen je Konto als Anzahl/Minuten (app/invites.py LIMITS): Einladungslinks anlegen (Standard 40/1440),
# Einladungslink einloesen (Standard 10/60; knapp, damit sich fremde Codes nicht durchprobieren lassen) und Belohnung
# abholen (Standard 10/60). Die Apple-ID der App fuer die Einloese-Adresse: LERNAPP_APPLE_APP_ID (Abschnitt 8).
LERNAPP_LIMIT_INVITE_CREATE_USER=
LERNAPP_LIMIT_INVITE_REDEEM_USER=
LERNAPP_LIMIT_INVITE_CLAIM_USER=
