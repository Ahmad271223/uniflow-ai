# UniFlow – gehosteter Dienst: Vorlage fuer deploy/.env (kopieren, ausfuellen, NIE einchecken: .gitignore deckt .env ab).
# docker compose liest diese Datei fuer die Variablen in docker-compose.yml und gibt sie dem App-Container mit.
# Keine Anfuehrungszeichen um Werte noetig; Zeilen mit # sind Kommentare. Anleitung: docs/release/BETRIEB.md

# ---------------------------------------------------------------- Domain und TLS (Caddy)
# Oeffentlicher Hostname des Dienstes (DNS A/AAAA zeigt auf den Server). Dient auch als LERNAPP_ALLOWED_HOSTS.
UNIFLOW_DOMAIN=app.example.de
# Kontaktadresse fuer Let's Encrypt (Hinweise vor Ablauf von Zertifikaten); kein Mailversand der App.
UNIFLOW_ACME_EMAIL=hosting@example.de

# ---------------------------------------------------------------- Betriebsart (app/config.py)
# hosted = Dienst mit UniFlow-Konten, jedes Konto mit eigenem Datenordner (im Image bereits gesetzt).
LERNAPP_MODE=hosted
# Datenordner und Protokollordner im Container (Volumes uniflow-data, uniflow-logs) – nicht aendern.
LERNAPP_DATA_DIR=/data
LERNAPP_LOG_DIR=/logs
# Hochschuldateien: stream = nie auf dem Server speichern, beim Oeffnen mit der Hochschulsitzung durchreichen
# (Standard im Dienst, app/filestream.py, hoechstens 300 MB je Datei). store = wie am PC, nur fuer Tests.
LERNAPP_FILES=stream
# Nur fuer die Windows-App: eigener Ort der .env. Im Container leer lassen (Werte kommen aus dieser Datei).
LERNAPP_ENV_FILE=
# Sitzungs-Cookie nur ueber https (Secure). Hinter Caddy immer 1.
LERNAPP_HTTPS=1
# Erlaubte Host-Kopfzeile (Schutz gegen DNS-Rebinding). docker-compose.yml setzt sie auf UNIFLOW_DOMAIN;
# weitere Namen (z. B. www.) mit Komma trennen.
LERNAPP_ALLOWED_HOSTS=app.example.de
# Rechtstexte (/datenschutz, /nutzungsbedingungen, /impressum, /konto-loeschen) als Markdown; im Image: docs/release.
# Eigener Ordner (z. B. mit ausgefuellten Platzhaltern) als Volume einhaengen und hier den Pfad eintragen.
LERNAPP_LEGAL_DIR=/srv/uniflow/docs/release

# ---------------------------------------------------------------- Dienst-Geheimnis (app/vault.py) – NIE VERLIEREN
# 32 Byte, base64 oder hex. Verschluesselt die Hochschul-Zugangsdaten aller Konten (Tresor in accounts.db).
# Erzeugen:  openssl rand -base64 32      oder      python -c "import secrets; print(secrets.token_hex(32))"
# Geht der Schluessel verloren, sind alle Tresor-Werte unlesbar (Nutzer muessen Zugangsdaten neu eingeben).
# Getrennt von den Backups aufbewahren (Passwort-Manager). Ohne Angabe erzeugt der Dienst /data/secret.key –
# dann liegt der Schluessel neben den Daten, das ist fuer den Betrieb NICHT vorgesehen.
LERNAPP_SECRET_KEY=

# ---------------------------------------------------------------- Abgleich-Jobs (app/jobs.py)
# inproc = Arbeiter und Zeitplan laufen im App-Prozess (Standard); off = keine Jobs (z. B. zweiter Container
# mit `python -m app.jobs`).
LERNAPP_JOBS=inproc
# Gleichzeitige Abgleiche = gleichzeitige Chromium-Browser, je 300–500 MB RAM. 2 passt zu 4 GB.
LERNAPP_JOB_WORKERS=2
# Uhrzeiten (Ortszeit des Containers, TZ=Europe/Berlin), zu denen jedes Konto mit Zugangsdaten abgeglichen wird.
LERNAPP_SYNC_TIMES=08:00,15:00

# ---------------------------------------------------------------- Loeschfristen (app/retention.py, Datenschutzerklaerung)
# Taeglich ab dieser Uhrzeit; die Zahlen muessen zur Datenschutzerklaerung passen (14 / 90 Tage).
LERNAPP_RETENTION_TIME=04:00
LERNAPP_RETENTION_ACCESS_DAYS=14
LERNAPP_RETENTION_SYNC_DAYS=90

# ---------------------------------------------------------------- Mailversand (app/mail.py)
# Passwort-Reset-Link und Willkommensmail. LERNAPP_MAIL: off = kein Versand | log = Mail nur in mail.log im
# Protokollordner (Reset-Link von dort holen) | smtp = Versand (Standard im Dienst, sobald LERNAPP_SMTP_HOST gesetzt ist).
# Ohne Mail-Anbieter auch moeglich: `docker compose exec app python -m app.accounts reset-token <email>`.
# Mail-Anbieter in die Datenschutzerklaerung (Abschnitt 11) und Auftragsverarbeitung abschliessen.
LERNAPP_MAIL=log
LERNAPP_SMTP_HOST=
# 587 = STARTTLS (Standard), 465 = TLS von Anfang an
LERNAPP_SMTP_PORT=587
LERNAPP_SMTP_USER=
LERNAPP_SMTP_PASSWORD=
# Absender; leer = SMTP-Nutzer bzw. no-reply@<Host von LERNAPP_PUBLIC_URL>
LERNAPP_MAIL_FROM=UniFlow <no-reply@example.de>
# Oeffentliche Adresse fuer Links in Mails (Reset-Link /login?reset=...), ohne Schraegstrich am Ende.
LERNAPP_PUBLIC_URL=https://app.example.de

# ---------------------------------------------------------------- Anmeldung mit Google/Apple (app/social_login.py)
# Erlaubte Client-IDs (Audience der ID-Tokens), kommagetrennt: Android-/iOS-Client-IDs bzw. Bundle-ID und Services-ID.
# Leer = Anbieter nicht eingerichtet (API antwortet 501 provider_not_configured). Die Web-Anmeldeseite braucht
# zusaetzlich die Web-Client-ID (wird automatisch mit erlaubt).
LERNAPP_GOOGLE_CLIENT_IDS=
LERNAPP_GOOGLE_WEB_CLIENT_ID=
LERNAPP_APPLE_CLIENT_IDS=
LERNAPP_APPLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------- Studora-KI ueber das Backend (app/ai_backend.py)
# Pro AI und neue KI-Tests (ab Plus) laufen nur ueber den Dienst; der Schluessel liegt nur hier, nie in der App.
# Ohne Schluessel und Modell antworten diese Funktionen ehrlich 503 ai_not_configured.
LERNAPP_AI_PROVIDER=
LERNAPP_OPENAI_API_KEY=
LERNAPP_AI_MODEL=
# Preise je 1 Mio. Tokens in EUR (fuer die Kostenprotokollierung, Tabelle ai_usage_log in accounts.db)
LERNAPP_AI_PRICE_IN_EUR=0
LERNAPP_AI_PRICE_OUT_EUR=0
# Budgets je Monat (gesamt und je Konto) und Anfragen je Konto und Minute; erreicht -> Sperre bis zum naechsten Monat
LERNAPP_AI_BUDGET_EUR=50
LERNAPP_AI_USER_BUDGET_EUR=2
LERNAPP_AI_RATE_PER_MINUTE=6

# ---------------------------------------------------------------- App-Store-Kaeufe (app/apple_store.py)
# Pfade zu Apples Wurzelzertifikat(en) (PEM oder DER, z. B. "Apple Root CA - G3" von apple.com/certificateauthority),
# kommagetrennt. Leer = Kaufpruefung nicht eingerichtet (503 apple_not_configured).
LERNAPP_APPLE_ROOT_CERTS=
LERNAPP_APPLE_BUNDLE_ID=de.uniflow.ai

# ---------------------------------------------------------------- Sonstiges
# Anmeldefenster fuer die Hochschul-Anmeldung (app/unilogin.py): Sekunden, bis es sich schliesst.
LERNAPP_UNILOGIN_TIMEOUT=300
# Nur Einzelplatz/WLAN-Betrieb; im Dienst ohne Wirkung (die Sitzung ersetzt die PIN). Leer lassen.
LERNAPP_ALLOW_PUBLIC_CLIENTS=
LERNAPP_LAN=
# Setzt nur die Windows-App (app/desktop.py): Links in ein neues Fenster oeffnet der Dienst im Standardbrowser. Leer lassen.
LERNAPP_DESKTOP=
# Nur fuer die Windows-App (app/service_link.py): Adresse des Studora-Dienstes fuer Konto und Community; sonst
# gibt der Nutzer sie beim Anmelden ein. Im Dienst selbst leer lassen.
LERNAPP_SERVICE_URL=
# Grenzen (P9): Anfragen je Konto und Minute im Dienst; gleichzeitige Abgleiche je Hochschule und Sekunden zwischen
# zwei Starts je Hochschule (schont Stud.IP und Learnweb).
LERNAPP_LIMIT_API_PER_MIN=600
LERNAPP_UNI_PARALLEL=2
LERNAPP_UNI_GAP_S=15
# Setzt nur die Windows-App beim Start ihres Backends (Geheimnis fuer den Fenster-Agenten, /api/desktop/*). Leer lassen.
LERNAPP_AGENT_TOKEN=
