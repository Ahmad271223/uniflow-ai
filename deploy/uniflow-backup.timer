# Zeitplan fuer uniflow-backup.service: taeglich 03:30 Ortszeit, vor den Loeschfristen des Dienstes (04:00).
# Alternative ohne systemd (Cron, als root):  30 3 * * * /srv/uniflow/app/deploy/backup.sh >> /var/log/uniflow-backup.log 2>&1
[Unit]
Description=UniFlow: Backup taeglich 03:30

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
