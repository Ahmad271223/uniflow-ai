# systemd-Dienst fuer das taegliche Backup (deploy/backup.sh) und die Kopie ausser Haus (deploy/backup-ausser-haus.sh).
# Einrichten auf dem Server:
#   sudo cp /srv/uniflow/app/deploy/uniflow-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now uniflow-backup.timer
#   sudo systemctl start uniflow-backup.service        # einmal von Hand pruefen
#   journalctl -u uniflow-backup.service -n 20         # Ausgabe ansehen
#
# Kopie ausser Haus als ExecStartPost statt eigenem Timer (Entscheidung 09.11.2026):
# - laeuft nur, wenn ExecStart (das lokale Backup samt Pruefung auf accounts.db) gelungen ist - nie gegen ein halbes
#   oder altes Archiv, keine Uhrzeit-Absprache zwischen zwei Timern, die bei RandomizedDelaySec auseinanderlaufen kann;
# - ein Fehler beim Hochladen markiert den Dienst als "failed" (systemctl --failed, journalctl) und dienst-check.sh meldet
#   "ausser_haus" nach 30 h; das lokale Archiv bleibt davon unberuehrt;
# - verpasste Tage holt der naechste Lauf selbst nach: das Skript laedt jedes lokale Archiv hoch, das auf der Box fehlt;
# - ohne OFFSITE_*-Werte in deploy/.env beendet es sich mit Exit 0 - der Dienst bleibt wie bisher gruen.
[Unit]
Description=UniFlow: taegliches Backup der Datenbanken und Nutzerdaten, danach verschluesselte Kopie ausser Haus
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/uniflow/app/deploy
Environment=BACKUP_DIR=/srv/uniflow/backups
Environment=BACKUP_KEEP_DAYS=14
ExecStart=/usr/bin/env bash /srv/uniflow/app/deploy/backup.sh
ExecStartPost=/usr/bin/env bash /srv/uniflow/app/deploy/backup-ausser-haus.sh
# Obergrenze fuer beide Schritte zusammen (rsync bricht haengende Verbindungen nach 10 min selbst ab)
TimeoutStartSec=6h
