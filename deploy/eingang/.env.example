# Datei-Eingang (deploy/eingang/docker-compose.yml). Kopieren nach deploy/eingang/.env und ausfuellen.
# Adresse des Eingangs: langer Zufallsname unter studinow.app (Wunsch des Inhabers 18.11.2026). Der echte Name steht
# NICHT im Repo, sondern nur in ~/Studora-Builds/private_keys/eingang-adresse.txt und in den .env-Dateien der Server.
EINGANG_DOMAIN=
# Kontaktadresse fuer Let's Encrypt
EINGANG_ACME_EMAIL=
# Gemeinsames Geheimnis mit dem StudiNow-Dienst (mindestens 32 Zeichen), z. B. `openssl rand -hex 32`.
# Im Dienst (deploy/.env) dasselbe als LERNAPP_INTAKE_SECRET und LERNAPP_INTAKE_URL=https://<EINGANG_DOMAIN>
LERNAPP_INTAKE_SECRET=
