# Datei-Eingang (deploy/eingang/docker-compose.yml). Kopieren nach deploy/eingang/.env und ausfuellen.
# Adresse dieses Rechners im privaten Hetzner-Netz (Konsole -> Netzwerke), z. B. 10.0.0.3. Keine Domain noetig.
EINGANG_PRIVATE_IP=
# Ordner des Hetzner-Volumes (Konsole zeigt den Einhaengepunkt, z. B. /mnt/HC_Volume_12345678)
EINGANG_DATA=/mnt/eingang
# Gemeinsames Geheimnis mit dem StudiNow-Dienst (mindestens 32 Zeichen), z. B. `openssl rand -hex 32`.
# Im Dienst (deploy/.env) dasselbe als LERNAPP_INTAKE_SECRET und LERNAPP_INTAKE_URL=http://<EINGANG_PRIVATE_IP>:8780
LERNAPP_INTAKE_SECRET=
