# Caddy vor dem UniFlow-Dienst: automatisches TLS (Let's Encrypt), HTTP -> HTTPS, Sicherheits-Kopfzeilen.
# Domain und E-Mail kommen aus der Umgebung des Caddy-Containers (deploy/docker-compose.yml <- deploy/.env).
# Die Content-Security-Policy, X-Frame-Options und Referrer-Policy fuer HTML setzt die App selbst (app/server.py).

{
	email {$UNIFLOW_ACME_EMAIL}
	servers {
		timeouts {
			read_header 30s
			# grosse PDF-Uploads und lange Abgleiche duerfen dauern
			read_body 15m
			idle 5m
		}
	}
}

{$UNIFLOW_DOMAIN} {
	encode zstd gzip

	# app/filestream.py reicht hoechstens 300 MB durch; etwas Luft fuer Multipart-Rahmen
	request_body {
		max_size 320MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# nur, wenn die App keine gesetzt hat (HTML-Seiten bekommen same-origin von der App)
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:8765 {
		# Client-IP und Schema fuer uvicorn (--proxy-headers); der Original-Host bleibt erhalten
		header_up X-Forwarded-Proto {scheme}
		transport http {
			# Antworten auf lange Anfragen (Abgleich anstossen, grosse Dateien) nicht vorzeitig abbrechen
			response_header_timeout 10m
			read_timeout 15m
			write_timeout 15m
			dial_timeout 10s
		}
	}

	log {
		# Caddy-Zugriffsprotokoll bewusst aus: die App fuehrt ihr eigenes mit 14-Tage-Frist (app/retention.py).
		# Fuer die Fehlersuche voruebergehend "output stderr" eintragen und `docker compose restart caddy`.
		output discard
	}
}
